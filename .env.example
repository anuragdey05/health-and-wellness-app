# Auth.js / NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Vercel's Google integration may provide these equivalent names instead.
# You only need one ID/secret pair.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. The app falls back to deterministic coaching copy.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
